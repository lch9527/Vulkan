#version 460
#extension GL_EXT_ray_tracing : require

layout( set = 0, binding = 0, rgba8 ) uniform image2D uOutputImage;
layout( set = 0, binding = 1 ) uniform accelerationStructureEXT uTopLevelAS;

layout( set = 0, binding = 3, std140 ) uniform raySceneBuf
{
	vec4 uCameraPos;
	vec4 uCameraForward;
	vec4 uCameraRight;
	vec4 uCameraUp;
	vec4 uLightPos[4];
	vec4 uLightColor[4];
	vec4 uLightControl;
	vec4 uMolecule;
} Scene;

layout( location = 0 ) rayPayloadEXT vec4 Payload;

vec3
SkyColor( vec3 direction )
{
	float t = clamp( direction.y * 0.5 + 0.5, 0.0, 1.0 );
	return mix( vec3( 0.58, 0.74, 0.95 ), vec3( 0.08, 0.28, 0.72 ), t );
}

vec3
FloorColor( vec3 point, vec3 rayOrigin )
{
	float checker = mod( floor( point.x ) + floor( point.z ), 2.0 );
	vec3 base = mix( vec3( 0.42, 0.43, 0.40 ), vec3( 0.74, 0.75, 0.70 ), checker );
	vec3 normal = vec3( 0.0, 1.0, 0.0 );
	vec3 viewDir = normalize( rayOrigin - point );
	vec3 color = base * 0.18;
	if( Scene.uLightControl.y > 0.5 )
	{
		for( int i = 0; i < 4; i++ )
		{
			vec3 lightVec = Scene.uLightPos[i].xyz - point;
			float dist2 = max( dot( lightVec, lightVec ), 0.25 );
			vec3 lightDir = normalize( lightVec );
			vec3 halfVec = normalize( lightDir + viewDir );
			float diffuse = max( dot( normal, lightDir ), 0.0 );
			float specular = pow( max( dot( normal, halfVec ), 0.0 ), 48.0 );
			float attenuation = 16.0 / dist2;
			color += Scene.uLightColor[i].rgb * attenuation * ( base * diffuse + vec3( 0.20 ) * specular );
		}
	}
	return color;
}

bool
FloorInside( vec3 point )
{
	vec2 center = vec2( 1.0, 0.8 );
	vec2 halfSize = vec2( 5.3, 5.3 );
	vec2 d = abs( point.xz - center );
	return d.x <= halfSize.x && d.y <= halfSize.y;
}

float
FloorChecker( vec3 point )
{
	return mod( floor( point.x ) + floor( point.z ), 2.0 );
}

float
RaySphereT( vec3 origin, vec3 direction, vec3 center, float radius )
{
	vec3 oc = origin - center;
	float b = dot( oc, direction );
	float c = dot( oc, oc ) - radius * radius;
	float h = b*b - c;
	if( h < 0.0 )
		return -1.0;
	h = sqrt( h );
	float t = -b - h;
	if( t > 0.001 )
		return t;
	t = -b + h;
	return t > 0.001 ? t : -1.0;
}

vec3
LightMarkerColorOnRay( vec3 origin, vec3 direction, float maxT, out float markerT )
{
	vec3 color = vec3( 0.0 );
	markerT = maxT;
	if( Scene.uLightControl.y <= 0.5 )
		return color;

	for( int i = 0; i < 4; i++ )
	{
		float radius = ( i == int(Scene.uLightControl.x + 0.5) ) ? 0.16 : 0.11;
		float lightT = RaySphereT( origin, direction, Scene.uLightPos[i].xyz, radius );
		if( lightT > 0.001 && lightT < markerT )
		{
			float halo = smoothstep( radius, 0.0, length( origin + lightT * direction - Scene.uLightPos[i].xyz ) );
			color = Scene.uLightColor[i].rgb * ( 2.5 + 2.0 * halo );
			markerT = lightT;
		}
	}
	return color;
}

void
main( )
{
	vec2 pixel = vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 );
	vec2 size = vec2( gl_LaunchSizeEXT.xy );
	vec2 ndc = pixel / size * 2.0 - 1.0;
	ndc.y = -ndc.y;

	float aspect = size.x / size.y;
	vec3 origin = Scene.uCameraPos.xyz;
	vec3 direction = normalize(
		Scene.uCameraForward.xyz * 1.8 +
		Scene.uCameraRight.xyz * ndc.x * aspect +
		Scene.uCameraUp.xyz * ndc.y
	);

	Payload = vec4( SkyColor( direction ), 10000.0 );
	traceRayEXT(
		uTopLevelAS,
		gl_RayFlagsOpaqueEXT,
		0xff,
		0,
		0,
		0,
		origin,
		0.001,
		direction,
		1000.0,
		0
	);

	vec3 color = Payload.rgb;
	float closestT = Payload.a;

	if( Scene.uLightControl.y > 0.5 )
	{
		float markerT;
		vec3 markerColor = LightMarkerColorOnRay( origin, direction, closestT, markerT );
		if( markerT < closestT )
		{
			color = markerColor;
			closestT = markerT;
		}
	}

	float floorT = 10000.0;
	if( direction.y < -0.001 )
		floorT = ( -0.80 - origin.y ) / direction.y;
	if( floorT > 0.001 && floorT < closestT )
	{
		vec3 floorPoint = origin + floorT * direction;
		if( FloorInside( floorPoint ) )
		{
			color = FloorColor( floorPoint, origin );
			if( FloorChecker( floorPoint ) > 0.5 )
			{
				vec3 floorNormal = vec3( 0.0, 1.0, 0.0 );
				vec3 reflectedDir = reflect( direction, floorNormal );
				vec3 reflectedOrigin = floorPoint + floorNormal * 0.01;
				Payload = vec4( SkyColor( reflectedDir ), 10000.0 );
				traceRayEXT(
					uTopLevelAS,
					gl_RayFlagsOpaqueEXT,
					0xff,
					0,
					0,
					0,
					reflectedOrigin,
					0.001,
					reflectedDir,
					1000.0,
					0
				);
				vec3 reflectedColor = Payload.rgb;
				float reflectedT = Payload.a;
				float reflectedMarkerT;
				vec3 reflectedMarkerColor = LightMarkerColorOnRay( reflectedOrigin, reflectedDir, reflectedT, reflectedMarkerT );
				if( reflectedMarkerT < reflectedT )
					reflectedColor = reflectedMarkerColor;
				color = mix( color, reflectedColor, 0.42 );
			}
		}
	}

	imageStore( uOutputImage, ivec2( gl_LaunchIDEXT.xy ), vec4( color, 1.0 ) );
}
